---
import Icon from './Icon.astro';
import Img from './Img.astro';
import { getReels, instagramRef } from '../lib/site';

interface Props {
  heading?: string;
}
const { heading = 'Toppers speak' } = Astro.props;
const reels = (await getReels())
  .map((r) => ({ id: r.id, ...r.data, ref: instagramRef(r.data.instagram_url)! }))
  .filter((r) => r.ref);
---

{reels.length > 0 && (
  <section class="panel bg-white border border-line" data-reels-root>
    <div class="container-x section-pad">
      <div class="mb-5 flex items-end justify-between gap-4 md:mb-10">
        <div>
          <span class="chip chip-kicker mb-4 md:mb-5">Testimonials</span>
          <h2 class="h2">{heading}</h2>
          <p class="mt-3 max-w-[520px] text-[15px] text-muted md:text-[17px]">
            Real students, real stories. Tap a reel to watch.
          </p>
        </div>
        <div class="hidden gap-2 md:flex">
          <button
            type="button"
            class="btn btn-white !h-12 !w-12 !p-0"
            data-reels-prev
            aria-label="Previous reels"
          >
            <Icon name="arrow-left" size={20} />
          </button>
          <button
            type="button"
            class="btn btn-dark !h-12 !w-12 !p-0"
            data-reels-next
            aria-label="Next reels"
          >
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>

      <div
        class="carousel -mx-5 px-5 md:mx-0 md:px-0"
        data-reels-track
        tabindex="0"
        role="region"
        aria-label="Topper testimonial reels"
      >
        {reels.map((r) => (
          <button
            type="button"
            class="group relative block aspect-[9/16] w-[148px] overflow-hidden rounded-[18px] bg-ink text-left text-white md:w-[210px] md:rounded-[24px] lg:w-[230px]"
            data-reel={r.ref.code}
            data-kind={r.ref.kind}
            data-name={r.student_name}
            aria-label={`Watch ${r.student_name}'s testimonial${r.label ? `, ${r.label}` : ''}`}
          >
            {r.cover ? (
              <Img
                src={r.cover}
                alt=""
                width={360}
                height={640}
                sizes="(min-width: 1024px) 230px, (min-width: 768px) 210px, 148px"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            ) : (
              <span class="absolute inset-0 bg-[linear-gradient(160deg,#0A1B5C,#0042F6_60%,#6047FF)]" />
            )}
            <span class="absolute inset-0 bg-[linear-gradient(to_top,rgb(26_27_31/0.88)_0%,rgb(26_27_31/0.15)_48%,transparent_70%)]" />
            <span class="absolute right-2 top-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-ink md:right-3 md:top-3">
              <Icon name="instagram" size={16} />
            </span>
            <span class="absolute left-1/2 top-[42%] inline-flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-ink shadow-lg transition-colors group-hover:bg-primary group-hover:text-white md:h-14 md:w-14">
              <Icon name="play" size={22} />
            </span>
            <span class="absolute inset-x-0 bottom-0 p-3 md:p-4">
              {r.label && (
                <span class="mono mb-1.5 inline-block rounded-full bg-primary px-2.5 py-1 text-[11px] font-medium md:text-[12px]">
                  {r.label.split('·')[0].trim()}
                </span>
              )}
              <span class="block font-heading text-[17px] font-bold uppercase leading-[1.05] md:text-[22px]">
                {r.student_name}
              </span>
              {r.label.includes('·') && (
                <span class="mono mt-1 block text-[10.5px] uppercase tracking-wide text-white/80 md:text-[12px]">
                  {r.label.split('·').slice(1).join('·').trim()}
                </span>
              )}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!--
        One dialog for every reel. Instagram's player (and its scripts and cookies) is only requested
        when a visitor taps a card. The iframe address is built here from a validated shortcode, and the
        iframe is sandboxed.
      -->
    <dialog id="reel-dialog" class="reel-dialog" aria-labelledby="reel-dialog-title">
      <div class="flex items-center justify-between gap-3 px-4 py-3">
        <p id="reel-dialog-title" class="h3 min-w-0 truncate !text-[18px]">
          Topper testimonial
        </p>
        <button
          type="button"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25"
          data-reel-close
          aria-label="Close video"
        >
          <Icon name="x" size={20} />
        </button>
      </div>
      <div class="reel-frame-wrap" data-reel-frame></div>
      <div class="flex items-center justify-between gap-3 px-4 py-3 text-[13px] text-white/70">
        <span>Plays from Instagram</span>
        <a
          data-reel-link
          href="https://www.instagram.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-white btn-sm"
        >
          Open on Instagram <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
    </dialog>
  </section>
)}

<script>
  const root = document.querySelector<HTMLElement>('[data-reels-root]');
  const dialog = document.getElementById('reel-dialog') as HTMLDialogElement | null;
  if (root && dialog) {
    const track = root.querySelector<HTMLElement>('[data-reels-track]')!;
    const step = () =>
      (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? 210;
    root
      .querySelector('[data-reels-prev]')
      ?.addEventListener('click', () =>
        track.scrollBy({ left: -(step() + 16) * 2, behavior: 'smooth' }),
      );
    root
      .querySelector('[data-reels-next]')
      ?.addEventListener('click', () =>
        track.scrollBy({ left: (step() + 16) * 2, behavior: 'smooth' }),
      );

    const wrap = dialog.querySelector<HTMLElement>('[data-reel-frame]')!;
    const title = dialog.querySelector<HTMLElement>('#reel-dialog-title')!;
    const link = dialog.querySelector<HTMLAnchorElement>('[data-reel-link]')!;

    track.addEventListener('click', (e) => {
      const card = (e.target as Element).closest<HTMLElement>('[data-reel]');
      if (!card) return;
      const code = card.dataset.reel ?? '';
      const kind = card.dataset.kind ?? 'reel';
      if (!/^[\w-]{5,20}$/.test(code) || !/^(reel|p|tv)$/.test(kind)) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.instagram.com/${kind}/${code}/embed/`;
      frame.title = `Testimonial by ${card.dataset.name ?? 'a topper'}`;
      frame.className = 'reel-frame';
      frame.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.setAttribute(
        'sandbox',
        'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-presentation',
      );
      wrap.replaceChildren(frame);
      title.textContent = card.dataset.name ?? 'Topper testimonial';
      link.href = `https://www.instagram.com/${kind}/${code}/`;
      dialog.showModal();
    });
    // Closing removes the player, which stops playback and any network activity.
    dialog.addEventListener('close', () => wrap.replaceChildren());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelector('[data-reel-close]')?.addEventListener('click', () => dialog.close());
  }
</script>
