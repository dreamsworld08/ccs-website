---
import Icon from './Icon.astro';
import Img from './Img.astro';
import { getReels, instagramRef } from '../lib/site';

interface Props {
  heading?: string;
}
const { heading = 'Toppers speak' } = Astro.props;
const reels = (await getReels())
  .map((r) => ({ id: r.id, ...r.data, ref: instagramRef(r.data.instagram_url)! }))
  .filter((r) => r.ref);
---

{reels.length > 0 && (
  <section class="panel bg-white border border-line" data-reels-root>
    <div class="container-x section-pad">
      <div class="mb-5 flex items-end justify-between gap-4 md:mb-10">
        <div>
          <span class="chip chip-kicker mb-4 md:mb-5">Testimonials</span>
          <h2 class="h2">{heading}</h2>
          <p class="mt-3 max-w-[520px] text-[15px] text-muted md:text-[17px]">
            Real students, real stories. Tap a card to open it.
          </p>
        </div>
        <div class="hidden gap-2 md:flex">
          <button
            type="button"
            class="btn btn-white !h-12 !w-12 !p-0"
            data-reels-prev
            aria-label="Previous reels"
          >
            <Icon name="arrow-left" size={20} />
          </button>
          <button
            type="button"
            class="btn btn-dark !h-12 !w-12 !p-0"
            data-reels-next
            aria-label="Next reels"
          >
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>

      <div
        class="carousel -mx-5 px-5 md:mx-0 md:px-0"
        data-reels-track
        tabindex="0"
        role="region"
        aria-label="Topper testimonial reels"
      >
        {reels.map((r) => (
          <button
            type="button"
            class="group relative block aspect-[9/16] w-[148px] overflow-hidden rounded-[18px] bg-ink text-left text-white md:w-[210px] md:rounded-[24px] lg:w-[230px]"
            data-reel={r.ref.code}
            data-kind={r.ref.kind}
            data-preview={r.dummy ? undefined : ''}
            data-name={r.student_name}
            aria-label={`Watch ${r.student_name}'s testimonial${r.label ? `, ${r.label}` : ''}`}
          >
            {r.cover ? (
              <Img
                src={r.cover}
                alt=""
                width={360}
                height={640}
                sizes="(min-width: 1024px) 230px, (min-width: 768px) 210px, 148px"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
              />
            ) : (
              <span class="absolute inset-0 bg-[linear-gradient(160deg,#0A1B5C,#0042F6_60%,#6047FF)]" />
            )}
            <span
              class="absolute inset-0 overflow-hidden"
              data-reel-preview
              aria-hidden="true"
              inert
            />
            <span class="absolute inset-0 bg-[linear-gradient(to_top,rgb(26_27_31/0.88)_0%,rgb(26_27_31/0.15)_48%,transparent_70%)]" />
            <span class="absolute right-2 top-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-ink md:right-3 md:top-3">
              <Icon name="instagram" size={16} />
            </span>
            {r.ref.kind !== 'p' && (
              <span
                class="absolute left-1/2 top-[42%] inline-flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-ink shadow-lg transition-colors group-hover:bg-primary group-hover:text-white md:h-14 md:w-14"
                data-reel-play
              >
                <Icon name="play" size={22} />
              </span>
            )}
            <span class="absolute inset-x-0 bottom-0 p-3 md:p-4">
              {r.label && (
                <span class="mono mb-1.5 inline-block rounded-full bg-primary px-2.5 py-1 text-[11px] font-medium md:text-[12px]">
                  {r.label.split('·')[0].trim()}
                </span>
              )}
              <span class="block font-heading text-[17px] font-bold uppercase leading-[1.05] md:text-[22px]">
                {r.student_name}
              </span>
              {r.label.includes('·') && (
                <span class="mono mt-1 block text-[10.5px] uppercase tracking-wide text-white/80 md:text-[12px]">
                  {r.label.split('·').slice(1).join('·').trim()}
                </span>
              )}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!--
        One dialog for every reel: tapping a card opens Instagram's player here (with sound). The iframe
        address is built from a validated shortcode, and the iframe is sandboxed.
        The cards themselves show a silent preview, see the script below.
      -->
    <dialog id="reel-dialog" class="reel-dialog" aria-labelledby="reel-dialog-title">
      <div class="flex items-center justify-between gap-3 px-4 py-3">
        <p id="reel-dialog-title" data-reel-title class="h3 min-w-0 truncate !text-[18px]">
          Topper testimonial
        </p>
        <button
          type="button"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white/15 text-white hover:bg-white/25"
          data-reel-close
          aria-label="Close video"
        >
          <Icon name="x" size={20} />
        </button>
      </div>
      <div class="reel-frame-wrap" data-reel-frame></div>
      <div class="flex items-center justify-between gap-3 px-4 py-3 text-[13px] text-white/70">
        <span>Plays from Instagram</span>
        <a
          data-reel-link
          href="https://www.instagram.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-white btn-sm"
        >
          Open on Instagram <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
    </dialog>
  </section>
)}

<script>
  import { setupPlayer } from '../scripts/ig-player';

  const root = document.querySelector<HTMLElement>('[data-reels-root]');
  const dialog = document.getElementById('reel-dialog') as HTMLDialogElement | null;
  if (root && dialog) {
    const track = root.querySelector<HTMLElement>('[data-reels-track]')!;
    const step = () =>
      (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? 210;
    root
      .querySelector('[data-reels-prev]')
      ?.addEventListener('click', () =>
        track.scrollBy({ left: -(step() + 16) * 2, behavior: 'smooth' }),
      );
    root
      .querySelector('[data-reels-next]')
      ?.addEventListener('click', () =>
        track.scrollBy({ left: (step() + 16) * 2, behavior: 'smooth' }),
      );

    const openPlayer = setupPlayer(dialog);

    track.addEventListener('click', (e) => {
      const card = (e.target as Element).closest<HTMLElement>('[data-reel]');
      if (!card) return;
      const name = card.dataset.name ?? '';
      openPlayer(
        card.dataset.kind ?? 'reel',
        card.dataset.reel ?? '',
        name || 'Topper testimonial',
        `Testimonial by ${name || 'a topper'}`,
      );
    });
    // ---- Previews: the cards show the real reel without a tap -------------------------------------------
    // Instagram's embed is heavy (about 3 MB for the first one), so nothing is requested until the carousel
    // is near the screen, and then only for cards that are (nearly) visible. It is skipped completely on
    // data-saver and slow connections, where the cover picture is shown instead. Previews are display-only
    // (no pointer events, not focusable): swiping scrolls the carousel and a tap opens the player above.
    const conn = (
      navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }
    ).connection;
    const lowData = Boolean(conn?.saveData) || /(^|-)(2|3)g/.test(conn?.effectiveType ?? '');
    const EMBED_WIDTH = 326; // Instagram's embed is laid out for this width
    const EMBED_HEADER = 54; // its profile bar, cropped away so the card shows the picture itself

    const attach = (card: HTMLElement) => {
      const holder = card.querySelector<HTMLElement>('[data-reel-preview]');
      const code = card.dataset.reel ?? '';
      const kind = card.dataset.kind ?? 'reel';
      const width = card.clientWidth;
      if (!holder || holder.firstChild || !width) return;
      if (!/^[\w-]{5,20}$/.test(code) || !/^(reel|p|tv)$/.test(kind)) return;
      // A reel is 9:16 like the card, so it fits by width. A photo post is roughly square: scale it to cover the
      // card (cropping the sides) so Instagram's likes bar below the picture stays out of view.
      const post = kind === 'p';
      const scale = (post ? card.clientHeight : width) / EMBED_WIDTH;
      const shiftX = post ? -(EMBED_WIDTH * scale - width) / 2 : 0;
      const frame = document.createElement('iframe');
      frame.src = `https://www.instagram.com/${kind}/${code}/embed/`;
      frame.title = `Preview of ${card.dataset.name ?? 'a topper'}'s testimonial`;
      frame.tabIndex = -1;
      frame.setAttribute('aria-hidden', 'true');
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.setAttribute(
        'sandbox',
        'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox allow-presentation',
      );
      frame.style.cssText =
        `position:absolute;left:0;top:0;width:${EMBED_WIDTH}px;max-width:none;height:800px;border:0;` +
        `pointer-events:none;opacity:0;transition:opacity .3s;transform-origin:0 0;` +
        `transform:translate(${shiftX}px,${-EMBED_HEADER * scale}px) scale(${scale})`;
      frame.addEventListener('load', () => (frame.style.opacity = '1'), { once: true });
      holder.appendChild(frame);
    };

    const cards = [...track.querySelectorAll<HTMLElement>('[data-reel][data-preview]')];
    if (cards.length && !lowData && 'IntersectionObserver' in window) {
      const start = () => {
        const near = new IntersectionObserver(
          (entries) =>
            entries.forEach((en) => {
              if (!en.isIntersecting) return;
              near.unobserve(en.target);
              attach(en.target as HTMLElement);
            }),
          { root: track, rootMargin: '0px 260px' }, // a card ahead is ready by the time it is swiped in
        );
        cards.forEach((c) => near.observe(c));
      };
      // First wait until the whole carousel is within a screen of the viewport.
      const section = new IntersectionObserver(
        ([en]) => {
          if (!en.isIntersecting) return;
          section.disconnect();
          start();
        },
        { rootMargin: '300px 0px' },
      );
      section.observe(track);
    }
  }
</script>
