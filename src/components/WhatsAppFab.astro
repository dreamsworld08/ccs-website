---
import Icon from './Icon.astro';
import { whatsappLink } from '../lib/site';
interface Props {
  number: string;
  lifted?: boolean;
}
const { number, lifted = false } = Astro.props;
---

<a
  href={whatsappLink(number)}
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp"
  class:list={[
    'fixed right-4 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-success text-white shadow-[0_8px_24px_rgb(17_173_37/0.4)] transition-transform hover:scale-105',
    lifted ? 'bottom-24 md:bottom-5' : 'bottom-5',
  ]}
>
  <Icon name="whatsapp" size={28} />
</a>
