---
import Icon from '../Icon.astro';
import CourseCard from '../CourseCard.astro';
import { withBase, getCourses } from '../../lib/site';
import type { getHome } from '../../lib/site';
interface Props {
  home: Awaited<ReturnType<typeof getHome>>;
}
const { home } = Astro.props;
const all = await getCourses();
const picked = home.featured_course_ids
  .map((id) => all.find((c) => c.id === id))
  .filter((c) => c !== undefined);
const featured = (picked.length ? picked : all).slice(0, 3);
---

<section class="panel bg-white border border-line">
  <div class="container-x section-pad">
    <div class="mb-8 flex flex-col gap-5 md:mb-12 md:flex-row md:items-end md:justify-between">
      <div>
        <span class="chip chip-kicker mb-5">Courses</span>
        <h2 class="h2">Courses we offer</h2>
      </div>
      <a href={withBase('/courses')} class="btn btn-secondary self-start">
        See all courses <Icon name="arrow-right" size={18} />
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((c) => (
        <CourseCard course={c} />
      ))}
    </div>
  </div>
</section>
