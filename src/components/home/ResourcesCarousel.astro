---
import Icon from '../Icon.astro';
import ResourceCard from '../ResourceCard.astro';
import { withBase, getResources } from '../../lib/site';
const items = (await getResources()).filter((r) => r.data.show_on_home);
---

{items.length > 0 && (
  <section class="panel bg-panel" data-carousel-root>
    <div class="container-x section-pad">
      <div class="mb-8 flex items-end justify-between gap-4 md:mb-12">
        <div>
          <span class="chip chip-kicker mb-5">Free resources</span>
          <h2 class="h2">Study material, free</h2>
        </div>
        <div class="hidden gap-2 md:flex">
          <button
            type="button"
            class="btn btn-white !h-12 !w-12 !p-0"
            data-carousel-prev
            aria-label="Previous resources"
          >
            <Icon name="arrow-left" size={20} />
          </button>
          <button
            type="button"
            class="btn btn-dark !h-12 !w-12 !p-0"
            data-carousel-next
            aria-label="Next resources"
          >
            <Icon name="arrow-right" size={20} />
          </button>
        </div>
      </div>
      <div
        class="carousel -mx-5 px-5 md:mx-0 md:px-0"
        data-carousel
        tabindex="0"
        role="region"
        aria-label="Free resources"
      >
        {items.map((r) => (
          <ResourceCard resource={r} class="w-[70vw] max-w-[290px] md:w-[320px]" />
        ))}
      </div>
      <div class="mt-8">
        <a href={withBase('/free-resources')} class="btn btn-dark">
          Browse all resources <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </section>
)}

<script>
  // Arrows scroll by one card using the browser's native smooth scrolling; touch users just swipe.
  document.querySelectorAll<HTMLElement>('[data-carousel-root]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel]')!;
    const step = () =>
      (track.firstElementChild as HTMLElement | null)?.getBoundingClientRect().width ?? 320;
    root
      .querySelector('[data-carousel-prev]')
      ?.addEventListener('click', () =>
        track.scrollBy({ left: -(step() + 16), behavior: 'smooth' }),
      );
    root
      .querySelector('[data-carousel-next]')
      ?.addEventListener('click', () => track.scrollBy({ left: step() + 16, behavior: 'smooth' }));
  });
</script>
