---
import Icon from '../Icon.astro';
import ResultCard from '../ResultCard.astro';
import { withBase, getResults } from '../../lib/site';
import type { getHome } from '../../lib/site';
interface Props {
  home: Awaited<ReturnType<typeof getHome>>;
}
const { home } = Astro.props;
const picks = (await getResults()).filter((r) => r.data.show_on_home).slice(0, 3);
const stat = home.stats[0] ?? { value: '500+', label: 'Selections' };
---

<section class="panel bg-white border border-line">
  <div class="container-x section-pad">
    <div class="mb-5 md:mb-12">
      <span class="chip chip-kicker mb-4 md:mb-5">Results</span>
      <h2 class="h2">Our toppers</h2>
    </div>
    <div class="grid gap-3 md:grid-cols-2 md:gap-4 lg:grid-cols-4">
      <div class="on-primary flex items-center justify-between gap-4 rounded-[18px] bg-primary p-4 text-white md:col-span-2 md:min-h-[260px] md:flex-col md:items-stretch md:justify-between md:rounded-[28px] md:p-8 lg:col-span-1">
        <div>
          <p class="mono text-[40px] font-medium leading-none md:text-[72px]">{stat.value}</p>
          <p class="mt-1.5 text-[14px] text-white/90 md:mb-6 md:mt-4 md:text-[17px]">
            {stat.label}
          </p>
        </div>
        <a
          href={withBase('/results')}
          class="btn btn-white btn-sm shrink-0 md:!px-6 md:!py-3.5 md:text-[15px]"
        >
          See all <span class="hidden md:inline">results</span>{' '}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      {/* Phones: swipeable row. From 768px the wrapper disappears (display: contents) and the cards join the grid. */}
      <div class="-mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-5 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:contents">
        {picks.map((r) => (
          <div class="w-[44vw] max-w-[200px] shrink-0 snap-start md:w-auto md:max-w-none md:contents">
            <ResultCard result={r} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
